# Kopie als .env anlegen und ausfuellen - .env ist in .gitignore.
# Client anlegen auf https://develop.battle.net/access/clients (kostenlos, Battle.net-Login).
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# eu, us, kr, tw. cn braucht einen eigenen Client und andere Hosts.
BLIZZARD_REGION=eu

# Sprache der Item-Namen und Stammdaten. Wird sie geaendert, holt `names` alles neu.
BLIZZARD_LOCALE=en_US

# Forever hat keine Realms, sondern Rulesets. EU/US kennen 1, 2, 3 und 15.
FOREVER_RULESETS=1,2,3,15

# Wohin die Rohdaten und das Warehouse geschrieben werden
AH_DATA_DIR=data

# Welches Auktionshaus gesammelt wird. 114 = Horde, Ruleset Normal (PvE Horde).
# Die Zuordnung steht in docs/forever-api.md.
FOREVER_HOUSE=114
FOREVER_RULESET=2

# ForeverDB (https://foreverdb.net/developers): Item-Namen und Stammdaten.
# Der Schluessel gehoert nur hierher und in die GitHub-Secrets - nie in die
# Oberflaeche, die laeuft im Browser und waere fuer jeden lesbar.
FOREVERDB_API_KEY=
